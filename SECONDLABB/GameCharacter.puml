@startuml

class GameCharacter {
    - name: CharacterName
    - health: double
    - level: int
    - experience: int
    - {static} objectCount: int

    + GameCharacter()
    + GameCharacter(newName: const CharacterName&, newHealth: double, newLevel: int, newExperience: int)
    + GameCharacter(other: const GameCharacter&)
    + ~GameCharacter()

    + {static} getObjectCount(): int
    + getName() const: CharacterName
    + getHealth() const: double
    + getLevel() const: int
    + getExperience() const: int

    + takeDamage(damage: double): bool
    + heal(amount: double): bool
    + addExperience(amount: int): bool
    + levelUp(): bool
    + print() const: void
}

class CharacterName {
    - name: std::string
    - adjective: std::string

    + CharacterName()
    + CharacterName(newName: const std::string&, newAdjective: const std::string&)

    + getName() const: std::string
    + getAdjective() const: std::string
    + getFullName() const: std::string
}

GameCharacter "1" *-- "1" CharacterName : name

note right of GameCharacter
    Инварианты:
    1. health — конечное число от 0 до 100
    2. level >= 1
    3. experience >= 0
end note

@enduml
